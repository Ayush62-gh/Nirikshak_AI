# Nirikshak AI - Environment Configuration Example

# Application
APP_NAME=Nirikshak_AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Database
# Default PostgreSQL URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nirikshak_db
# Sync DB URL for Alembic migrations if needed (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirikshak_db

# Security & JWT
JWT_SECRET=supersecretjwtkeyfornirikshaklegalmetrologycompliancesystem2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_SIZE_MB=25

# Rules & Parameters Data
RULES_FILE_PATH=data/rules/legal_metrology_rules.json
RULE_PARAMS_FILE_PATH=data/rules/rule_parameters.json

# OCR Engine
OCR_PROVIDER=tesseract
TESSERACT_CMD=
